{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "бэкенд: собрать",
      "type": "shell",
      "command": "dotnet",
      // SDK, поставленный скриптом dotnet-install.ps1, ложится в профиль и в PATH
      // текущего окна VS Code не попадает — дописываем его сами, чтобы работало без перезапуска.
      "options": {
        "env": { "PATH": "${env:PATH};${env:USERPROFILE}\\.dotnet;${env:USERPROFILE}\\.dotnet\\tools" }
      },
      "args": [
        "build",
        "${workspaceFolder}/backend/Talkaton.sln",
        "-p:GenerateFullPaths=true",
        "-consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "фронтенд: ng serve",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          // Отладчик ждёт этой строки, чтобы открыть браузер уже по готовой сборке.
          "activeOnStart": true,
          "beginsPattern": { "regexp": "(Changes detected|Building\\.\\.\\.)" },
          "endsPattern": { "regexp": "(bundle generation (complete|failed)|Local:\\s+http)" }
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "docker: поднять стенд",
      "type": "shell",
      "command": "docker compose up -d --build --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "docker: остановить стенд",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "docker: снести стенд вместе с базой",
      "type": "shell",
      "command": "docker compose down -v",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "тесты: бэкенд",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "env": { "PATH": "${env:PATH};${env:USERPROFILE}\\.dotnet;${env:USERPROFILE}\\.dotnet\\tools" }
      },
      "args": ["test", "${workspaceFolder}/backend/Talkaton.sln"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "тесты: фронтенд",
      "type": "shell",
      "command": "npx ng test --watch=false",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "фронтенд: линт",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "миграции: проверить расхождение с моделью",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "env": { "PATH": "${env:PATH};${env:USERPROFILE}\\.dotnet;${env:USERPROFILE}\\.dotnet\\tools" }
      },
      "args": [
        "ef",
        "migrations",
        "has-pending-model-changes",
        "--project",
        "${workspaceFolder}/backend/src/Talkaton.Infrastructure",
        "--startup-project",
        "${workspaceFolder}/backend/src/Talkaton.Infrastructure"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
